<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/radius"
            android:orientation="vertical"
            android:padding="14dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/BtnClose_StreamDlg"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/sans"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/TxtcolorHome2"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TxtHeader_StreamDlg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/BtnClose_StreamDlg"
                    android:fontFamily="@font/sans"
                    android:gravity="right"
                    android:text="لینک مستقیم استریم"
                    android:textColor="@color/TxtcolorHome"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/TxtMovieTitle_StreamDlg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/sans"
                android:gravity="right"
                android:maxLines="2"
                android:textColor="@color/TxtcolorHome2"
                android:textSize="12sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/ViewHBtnC" />

            <TextView
                android:id="@+id/TxtStatus_StreamDlg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sans"
                android:gravity="right"
                android:text="لینک نهایی آماده است"
                android:textColor="@color/BtnPopLogin"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/stream_url_box_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/TxtUrl_StreamDlg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:gravity="left"
                    android:maxLines="4"
                    android:textColor="@color/TxtcolorHome"
                    android:textDirection="ltr"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/BtnOpenUrl_StreamDlg"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/stream_btn_primary_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/sans"
                android:gravity="center"
                android:text="باز کردن لینک"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/BtnCopyUrl_StreamDlg"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/stream_btn_secondary_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/sans"
                android:gravity="center"
                android:text="کپی لینک"
                android:textColor="@color/TxtcolorHome"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/BtnAdmUrl_StreamDlg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/radius_bg_item_pop_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sans"
                    android:gravity="center"
                    android:text="دانلود مستقیم با ADM"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginLeft="8dp"
                    android:src="@drawable/ic_adm" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
