<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/radius"
            android:orientation="vertical"
            android:padding="10dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/BtnClose_StreamDlg"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/sans"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/TxtcolorHome2"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TxtHeader_StreamDlg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/BtnClose_StreamDlg"
                    android:fontFamily="@font/sans"
                    android:gravity="right"
                    android:text="گربر لینک‌های استریم"
                    android:textColor="@color/TxtcolorHome"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/TxtMovieTitle_StreamDlg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/sans"
                android:gravity="right"
                android:maxLines="1"
                android:textColor="@color/TxtcolorHome2"
                android:textSize="11sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/ViewHBtnC" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/BtnDialogGrabberToggle_StreamDlg"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/stream_toggle_on_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/sans"
                    android:gravity="center"
                    android:paddingLeft="9dp"
                    android:paddingRight="9dp"
                    android:text="گربر: روشن"
                    android:textColor="#FF2E7D32"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TxtStatus_StreamDlg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/sans"
                    android:gravity="right"
                    android:text="لینک نهایی آماده است"
                    android:textColor="@color/BtnPopLogin"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/RowFilters_StreamDlg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fillViewport="true"
                android:layoutDirection="rtl"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="right|center_vertical"
                    android:layoutDirection="rtl"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/TabFilterAll_StreamDlg"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/stream_btn_primary_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/sans"
                        android:gravity="center"
                        android:paddingLeft="9dp"
                        android:paddingRight="9dp"
                        android:text="همه"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/TabFilterVideo_StreamDlg"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/stream_btn_secondary_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/sans"
                        android:gravity="center"
                        android:paddingLeft="9dp"
                        android:paddingRight="9dp"
                        android:text="ویدیو"
                        android:textColor="@color/TxtcolorHome"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/TabFilterStream_StreamDlg"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/stream_btn_secondary_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/sans"
                        android:gravity="center"
                        android:paddingLeft="9dp"
                        android:paddingRight="9dp"
                        android:text="HLS / DASH"
                        android:textColor="@color/TxtcolorHome"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/TabFilterExtra_StreamDlg"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/stream_btn_secondary_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/sans"
                        android:gravity="center"
                        android:paddingLeft="9dp"
                        android:paddingRight="9dp"
                        android:text="صدا / زیرنویس"
                        android:textColor="@color/TxtcolorHome"
                        android:textSize="10sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <ScrollView
                android:id="@+id/ScrollLinks_StreamDlg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fadeScrollbars="false">

                <LinearLayout
                    android:id="@+id/ListLinks_StreamDlg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/TxtEmptyLinks_StreamDlg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/sans"
                android:gravity="center"
                android:padding="8dp"
                android:text="هنوز لینکی از شبکه دریافت نشده است"
                android:textColor="@color/TxtcolorHome2"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/stream_url_box_bg"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/TxtUrl_StreamDlg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:gravity="left"
                    android:singleLine="true"
                    android:textColor="@color/TxtcolorHome"
                    android:textDirection="ltr"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/BtnCopyUrl_StreamDlg"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/stream_btn_secondary_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/sans"
                    android:gravity="center"
                    android:text="کپی لینک"
                    android:textColor="@color/TxtcolorHome"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/BtnOpenUrl_StreamDlg"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/stream_btn_primary_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/sans"
                    android:gravity="center"
                    android:text="باز کردن لینک"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/BtnAdmUrl_StreamDlg"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/radius_bg_item_pop_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sans"
                    android:gravity="center"
                    android:text="دانلود مستقیم با ADM"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="8dp"
                    android:src="@drawable/ic_adm" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
