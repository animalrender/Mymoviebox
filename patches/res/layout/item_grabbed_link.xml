<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/CardRoot_GrabItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:background="@drawable/stream_link_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/TxtItemSelected_GrabItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sans"
            android:text="✓ انتخاب شده"
            android:textColor="#FF0277BD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/TxtItemSize_GrabItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:fontFamily="@font/sans"
            android:textColor="@color/TxtcolorHome2"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/TxtItemQuality_GrabItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:background="@drawable/stream_badge_bg"
            android:fontFamily="@font/sans"
            android:paddingLeft="6dp"
            android:paddingTop="1dp"
            android:paddingRight="6dp"
            android:paddingBottom="1dp"
            android:textColor="@color/TxtcolorHome"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/TxtItemType_GrabItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/stream_badge_bg"
            android:fontFamily="@font/sans"
            android:paddingLeft="7dp"
            android:paddingTop="1dp"
            android:paddingRight="7dp"
            android:paddingBottom="1dp"
            android:text="ویدیو"
            android:textColor="#FF0288D1"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/TxtItemName_GrabItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="middle"
        android:gravity="left"
        android:singleLine="true"
        android:textColor="@color/TxtcolorHome"
        android:textDirection="ltr"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/TxtItemUrl_GrabItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="middle"
        android:gravity="left"
        android:singleLine="true"
        android:textColor="@color/TxtcolorHome2"
        android:textDirection="ltr"
        android:textSize="10sp" />
</LinearLayout>
